# Set to "true" for local development without a real Tesla Developer account —
# simulates the whole OAuth + charging flow. NEVER set this in production/Vercel.
USE_FAKE_TESLA_API=true

# Tesla Developer app credentials (https://developer.tesla.com).
# Required when USE_FAKE_TESLA_API is not "true".
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Password for encrypting the session cookie (iron-session). Must be 32+ characters.
# Required in production; a fixed insecure fallback is used in development.
IRON_SESSION_PASSWORD=dev-only-insecure-password-change-me-32ch
